<Window x:Class="GameValueEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="肝肾大圣-单机游戏数值编辑器" Icon="pack://application:,,,/GameValueEditor;component/Assets/GameValueEditorIcon.png" Height="820" Width="1320"
        MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="肝肾大圣-单机游戏数值编辑器" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="LOCAL GAME VALUE EDITOR" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          MaxWidth="660" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="82" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="Display" SelectionChanged="Theme_OnSelectionChanged" ToolTip="切换应用主题"/>
                    <Button Content="刷新进程" Click="RefreshProcesses_OnClick"/>
                    <Button Content="连接" Click="AttachProcess_OnClick"/>
                    <Button Content="保存到游戏库" Click="AddGame_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游戏库" FontSize="18" FontWeight="SemiBold" Margin="7,5"/>
                        <TextBlock Grid.Column="1" Text="本地" Foreground="{DynamicResource MutedTextBrush}" Margin="7"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="4,8,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按游戏名称或进程名搜索"/>
                        <Button Grid.Column="1" Content="清空" Margin="6,0,0,0" Padding="10,6" Click="ClearGameSearch_OnClick"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedLibraryGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                        <Image Source="{Binding IconSource}" Width="28" Height="28" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Badges, Mode=OneWay}"/><Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ConnectionDisplay}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="3">
                            <Button Content="置顶" Click="PinGame_OnClick"/>
                            <Button Content="锁定" Click="LockGame_OnClick"/>
                            <Button Content="重命名" Click="RenameGame_OnClick"/>
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" Columns="3">
                            <Button Content="连接游戏" Click="AttachSelectedGame_OnClick"/>
                            <Button Content="断开连接" Click="DisconnectSelectedGame_OnClick"/>
                            <Button Content="删除游戏" Click="DeleteGame_OnClick"/>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18" Background="{DynamicResource WindowBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="9" Background="{DynamicResource PanelRaisedBrush}" Margin="0,0,12,0">
                            <Image Source="{Binding ActiveGameIcon}" Width="38" Height="38" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveGameDisplayName}" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="游戏版本" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding SelectedGame.Versions}" SelectedItem="{Binding SelectedVersion}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VersionChoiceText}" ToolTip="{Binding TechnicalDetails}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,6" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding SpeedStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,18,0" MinWidth="105"/>
                        <TextBlock Text="倍数：" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SpeedMultiplier, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                 ToolTip="输入 1 到 100 的整数"/>
                        <Button Content="加速" IsEnabled="{Binding CanAccelerate}" Click="AccelerateGame_OnClick"/>
                        <Button Content="回正" IsEnabled="{Binding CanRestoreSpeed}" Click="RestoreGameSpeed_OnClick"/>
                    </DockPanel>
                </Border>

                <TabControl Grid.Row="2">
                    <TabItem Header="本游专属">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ActiveAdapterText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ModuleStatusText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,10,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="检查新有" IsEnabled="{Binding CanCheckGameModules}"
                                            Click="CheckGameModules_OnClick"/>
                                    <Button Grid.Column="2" Content="可更新" IsEnabled="{Binding CanInstallGameModule}"
                                            Click="InstallGameModule_OnClick"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <StackPanel Visibility="{Binding HasNoActiveAdapter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                                    <TextBox Text="本地未装配该游戏专属修改模块，可使用“通用扫描”。"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                                             Background="Transparent" FontSize="20" FontWeight="SemiBold"
                                             TextAlignment="Center" TextWrapping="Wrap" Cursor="IBeam"/>
                                    <TextBox Text="请点击上方“检查新有”按钮。"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                                             Background="Transparent" FontSize="17" Foreground="{DynamicResource MutedTextBrush}"
                                             Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" Cursor="IBeam"/>
                                    <TextBox Text="如有额外需要，也可参与维护本开源项目，或者联系作者QQ群：1127372613"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                                             Background="Transparent" FontSize="17" Foreground="{DynamicResource MutedTextBrush}"
                                             Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Cursor="IBeam"/>
                                </StackPanel>
                                <TabControl Visibility="{Binding HasActiveAdapter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TabItem Header="背包物品数量" IsEnabled="{Binding HasActiveInventoryAdapter}">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                                       Text="读取游戏当前背包；双击物品即可实时修改并调用游戏自身保存流程。"/>
                                            <TextBox Grid.Column="1" Margin="8,0,0,0"
                                                     Text="{Binding AdapterItemNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="按物品名称查找"/>
                                            <TextBox Grid.Column="2" Margin="8,0,0,0"
                                                     Text="{Binding AdapterItemCountFilter, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="按物品数量精确查找"/>
                                            <Button Grid.Column="3" Content="刷新背包" Click="RefreshAdapterInventory_OnClick"/>
                                        </Grid>
                                        <DataGrid x:Name="AdapterInventoryGrid" Grid.Row="1" Margin="0,10"
                                                   ItemsSource="{Binding AdapterItemsView}" SelectedItem="{Binding SelectedAdapterItem}"
                                                   IsReadOnly="True" SelectionMode="Extended"
                                                   SelectionChanged="AdapterInventoryGrid_OnSelectionChanged"
                                                   MouseDoubleClick="AdapterInventoryGrid_OnMouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="物品名称" Binding="{Binding DisplayName}" Width="2*"/>
                                                <DataGridTextColumn Header="物品总数" Binding="{Binding CountDisplay}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="SaveAdapterFieldButton" Content="添加到已保存字段…" IsEnabled="False" Click="SaveAdapterItem_OnClick"/>
                                            <Button x:Name="WriteAdapterItemsButton" Content="修改选中物品…" IsEnabled="False" Click="WriteAdapterItem_OnClick"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="通用扫描">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ScanValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入游戏中当前显示的数值"/>
                                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding ValueTypes}"
                                          SelectedValue="{Binding SelectedValueType}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding Comparisons}"
                                          SelectedValue="{Binding SelectedComparison}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                <ComboBox Grid.Column="3" Margin="8,0,0,0" ItemsSource="{Binding SearchRoutines}"
                                          SelectedItem="{Binding SelectedSearchRoutine}" DisplayMemberPath="DisplayName"
                                          ToolTip="搜索套路是可复用的数值编码/定位方式"/>
                                <Grid Grid.Column="4" Margin="8,0,0,0" ToolTip="按比例存储的倍数；例如界面 10、内存 20 时填 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="倍数" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ScaleMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Button Grid.Column="5" Content="首次扫描" Click="NewScan_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                                <Button Grid.Column="6" Content="再次扫描" Click="NextScan_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                                <Button Grid.Column="7" Content="撤销扫描" Click="UndoScan_OnClick" IsEnabled="{Binding CanUndoScan}"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,10,2,8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="仅扫描可写内存" IsChecked="{Binding WritableOnly}" Margin="0,0,18,0"/>
                                    <CheckBox Content="按类型对齐" IsChecked="{Binding AlignedOnly}" Margin="0,0,18,0"/>
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="候选："/><Run Text="{Binding ScanResultCount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="取消扫描" Click="CancelScan_OnClick" IsEnabled="{Binding IsBusy}"/>
                                    <Button Content="清空结果" Click="ResetScan_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Height="3" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelRaisedBrush}"/>
                             <DataGrid x:Name="ScanResultsGrid" Grid.Row="3" Margin="0,10,0,10" ItemsSource="{Binding VisibleScanResults}"
                                       SelectedItem="{Binding SelectedScanResult}" IsReadOnly="True" SelectionMode="Extended"
                                       SelectionChanged="ScanResultsGrid_OnSelectionChanged"
                                       MouseDoubleClick="ScanResultsGrid_OnMouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding AddressDisplay}" Width="1.6*"/>
                                    <DataGridTextColumn Header="界面值" Binding="{Binding CurrentDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="原始存储值" Binding="{Binding RawCurrentDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="首次" Binding="{Binding FirstDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="上一次" Binding="{Binding PreviousDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding ValueType}" Width="*"/>
                                    <DataGridTextColumn Header="搜索套路" Binding="{Binding RoutineDisplay}" Width="1.4*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                             <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="WriteScanResultsButton" Content="修改选中结果…" IsEnabled="False" Click="WriteScanResults_OnClick"/>
                                <Button x:Name="SaveScanFieldButton" Content="保存选中字段…" IsEnabled="False" Click="SaveField_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="快捷入口">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="将某个修改项保存到此处，作为已保存字段。" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="重启游戏或肝肾大圣后，可以自动定位已保存的字段，方便快捷修改。"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <Button Content="刷新数值" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshFields_OnClick"/>
                            </Grid>
                            <DataGrid x:Name="SavedFieldsGrid" Grid.Row="1" ItemsSource="{Binding SavedFields}"
                                      SelectedItem="{Binding SelectedSavedField}" IsReadOnly="True"
                                      MouseDoubleClick="SavedFieldsGrid_OnMouseDoubleClick"
                                      PreviewMouseLeftButtonDown="SavedFieldsGrid_OnPreviewMouseLeftButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="备注名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="*"/>
                                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="*"/>
                                    <DataGridTextColumn Header="锁定状态" Binding="{Binding LockDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="地址" Binding="{Binding AddressDisplay}" Width="1.5*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="删除字段" Click="DeleteField_OnClick"/>
                                <Button Content="修改字段值…" Click="WriteField_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="游戏版本">
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="版本用途"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.VersionChoiceText}" VerticalAlignment="Center"/>
                            <Label Grid.Row="1" Content="文件版本"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.FileVersion}" VerticalAlignment="Center"/>
                            <Label Grid.Row="2" Content="产品版本"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.ProductVersion}" VerticalAlignment="Center"/>
                            <Label Grid.Row="3" Content="架构"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.Architecture}" VerticalAlignment="Center"/>
                            <Label Grid.Row="4" Content="收录日期"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVersion.CollectedDateDisplay}" VerticalAlignment="Center"/>
                            <Label Grid.Row="5" Content="版本指纹（技术信息）"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVersion.ExecutableSha256}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,20,0,0">
                                <TextBlock Text="本地数据位置" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LibraryPath}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,12"/>
                                <Button Content="在资源管理器中显示" HorizontalAlignment="Left" Click="OpenLibraryFolder_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center">
                        <Run Text="仅用于离线单机游戏 · v"/><Run Text="{Binding CurrentApplicationVersion, Mode=OneWay}"/><Run Text="（"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ApplicationUpdateStatusPrefix}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="{Binding ApplicationUpdateActionText}" IsEnabled="{Binding CanUseApplicationUpdate}"
                            Click="ApplicationUpdate_OnClick" Padding="6,1" Margin="0" MinHeight="22"/>
                    <TextBlock Text="）" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="官网" IsEnabled="{Binding CanOpenOfficialWebsite}"
                            Click="OpenOfficialWebsite_OnClick" Padding="10,1" Margin="24,0,0,0" MinHeight="22"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
