<Window x:Class="GameValueEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单机游戏数值编辑器" Height="820" Width="1320"
        MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="单机游戏数值编辑器" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="LOCAL GAME VALUE EDITOR" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="DisplayName"
                          MaxWidth="700" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新进程" Click="RefreshProcesses_OnClick"/>
                    <Button Content="连接" Style="{StaticResource PrimaryButton}" Click="AttachProcess_OnClick"/>
                    <Button Content="保存到游戏库" Click="AddGame_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游戏库" FontSize="18" FontWeight="SemiBold" Margin="7,5"/>
                        <TextBlock Grid.Column="1" Text="本地" Foreground="{StaticResource MutedTextBrush}" Margin="7"/>
                    </Grid>
                    <TextBox Grid.Row="1" Margin="4,8,4,10" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="#243B5A" Margin="0,0,10,0">
                                        <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Badges}"/><Run Text="{Binding Name}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="3">
                            <Button Content="置顶" Click="PinGame_OnClick"/>
                            <Button Content="锁定" Click="LockGame_OnClick"/>
                            <Button Content="重命名" Click="RenameGame_OnClick"/>
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" Columns="2">
                            <Button Content="连接所选游戏" Click="AttachSelectedGame_OnClick"/>
                            <Button Content="删除游戏" Style="{StaticResource DangerButton}" Click="DeleteGame_OnClick"/>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=尚未选择游戏}" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="游戏版本" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding SelectedGame.Versions}" SelectedItem="{Binding SelectedVersion}"
                                  DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1">
                    <TabItem Header="扫描数值">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ScanValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入游戏中当前显示的数值"/>
                                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding ValueTypes}"
                                          SelectedValue="{Binding SelectedValueType}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding Comparisons}"
                                          SelectedValue="{Binding SelectedComparison}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                <Button Grid.Column="3" Content="首次扫描" Style="{StaticResource PrimaryButton}" Click="NewScan_OnClick"/>
                                <Button Grid.Column="4" Content="再次扫描" Click="NextScan_OnClick"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,10,2,8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="仅扫描可写内存" IsChecked="{Binding WritableOnly}" Margin="0,0,18,0"/>
                                    <CheckBox Content="按类型对齐" IsChecked="{Binding AlignedOnly}" Margin="0,0,18,0"/>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}">
                                        <Run Text="候选："/><Run Text="{Binding ScanResultCount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="取消扫描" Click="CancelScan_OnClick"/>
                                    <Button Content="清空结果" Click="ResetScan_OnClick"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Height="3" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelRaisedBrush}"/>
                            <DataGrid Grid.Row="3" Margin="0,10,0,10" ItemsSource="{Binding VisibleScanResults}"
                                      SelectedItem="{Binding SelectedScanResult}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding AddressDisplay}" Width="2*"/>
                                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="上一次" Binding="{Binding PreviousDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding ValueType}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="用选中结果更新字段位置" Click="RelocateField_OnClick"/>
                                <Button Content="保存选中字段…" Style="{StaticResource PrimaryButton}" Click="SaveField_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="已保存字段">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="玩家命名的字段" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="动态地址在游戏重启后会标记为需要重新定位；模块偏移会自动恢复。"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <Button Content="刷新数值" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshFields_OnClick"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SavedFields}" SelectedItem="{Binding SelectedSavedField}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="*"/>
                                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="地址" Binding="{Binding AddressDisplay}" Width="1.5*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="删除字段" Style="{StaticResource DangerButton}" Click="DeleteField_OnClick"/>
                                <Button Content="修改数值…" Style="{StaticResource PrimaryButton}" Click="WriteField_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="版本信息">
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="档案版本"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.DisplayName}" VerticalAlignment="Center"/>
                            <Label Grid.Row="1" Content="文件版本"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.FileVersion}" VerticalAlignment="Center"/>
                            <Label Grid.Row="2" Content="产品版本"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.ProductVersion}" VerticalAlignment="Center"/>
                            <Label Grid.Row="3" Content="架构"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.Architecture}" VerticalAlignment="Center"/>
                            <Label Grid.Row="4" Content="版本指纹"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVersion.ExecutableSha256}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,20,0,0">
                                <TextBlock Text="本地数据位置" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LibraryPath}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,12"/>
                                <Button Content="在资源管理器中显示" HorizontalAlignment="Left" Click="OpenLibraryFolder_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0A0F15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                           Text="仅用于离线单机游戏 · v0.1.1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
