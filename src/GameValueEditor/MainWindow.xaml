<Window x:Class="GameValueEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:GameValueEditor.ViewModels"
        Title="肝肾大圣-单机游戏数值编辑器" Icon="pack://application:,,,/GameValueEditor;component/Assets/GameValueEditorIcon.png" Height="820" Width="1320"
        Style="{StaticResource ThemedWindowStyle}"
        MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:AdapterInventoryEditorPageState}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Descriptor.Description}"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding DataContext.AdapterItemNameFilter, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按物品名称查找"/>
                    <TextBox Grid.Column="1" Margin="8,0,0,0"
                             Text="{Binding DataContext.AdapterItemCountFilter, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按物品数量精确查找"/>
                    <Button Grid.Column="2" Content="刷新背包" Click="RefreshAdapterInventory_OnClick"/>
                </Grid>
                <DataGrid x:Name="AdapterInventoryGrid" Grid.Row="2" Margin="0,10"
                          ItemsSource="{Binding DataContext.AdapterItemsView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          SelectedItem="{Binding DataContext.SelectedAdapterItem, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          IsReadOnly="True" SelectionMode="Extended"
                          MouseDoubleClick="AdapterInventoryGrid_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="物品名称" Binding="{Binding DisplayName}" Width="2*"/>
                        <DataGridTextColumn Header="物品总数" Binding="{Binding CountDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="添加到已保存字段…" Click="SaveAdapterItem_OnClick"
                            Tag="{Binding ElementName=AdapterInventoryGrid}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItems.Count, ElementName=AdapterInventoryGrid}" Value="1">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="修改选中物品…" Click="WriteAdapterItem_OnClick"
                            Tag="{Binding ElementName=AdapterInventoryGrid}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=AdapterInventoryGrid}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AdapterCharacterEditorPageState}">
            <Grid Margin="12">
                <TextBlock Visibility="{Binding IsUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620"
                           Text="当前游戏构建暂不支持这个人物属性页面；其他受支持页面仍可正常使用。"
                           FontSize="18" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                <Grid Visibility="{Binding IsSupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Descriptor.Description}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                                       Visibility="{Binding DataContext.IsSelectedCharacterFieldSessionOnly, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="当前选中字段仅本次游戏运行有效；关闭或重启游戏后恢复。"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Margin="8,0,0,0"
                                 Text="{Binding DataContext.CharacterAttributeNameFilter, RelativeSource={RelativeSource AncestorType={x:Type Window}}, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按人物属性名称查找"/>
                        <Button Grid.Column="2" Content="刷新人物" Click="RefreshAdapterCharacters_OnClick"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding DataContext.AdapterCharacters, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 SelectedItem="{Binding DataContext.SelectedAdapterCharacter, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DataGrid Grid.Column="2"
                                  ItemsSource="{Binding DataContext.CharacterAttributesView, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  SelectedItem="{Binding DataContext.SelectedCharacterAttribute, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="AdapterCharacterAttributesGrid_OnMouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="属性" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="基础结果" Binding="{Binding RawValueDisplay}" Width="*"/>
                                <DataGridTextColumn Header="游戏界面总值" Binding="{Binding AggregatedValueDisplay}" Width="*"/>
                                <DataGridTextColumn Header="成长" Binding="{Binding GrowthValueDisplay}" Width="*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="添加到已保存字段…" Click="SaveCharacterAttribute_OnClick"
                                IsEnabled="{Binding DataContext.SelectedCharacterAttribute.CanWrite, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                        <Button Content="修改选中属性…" Click="WriteCharacterAttribute_OnClick"
                                IsEnabled="{Binding DataContext.SelectedCharacterAttribute.CanWrite, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AdapterEntityEditorState}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Descriptor.Description}" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0"
                              ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup}"
                              Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ToolTip="按类别筛选"/>
                    <TextBox Grid.Column="2" Margin="8,0,0,0"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按项目或字段名称查找"/>
                    <Button Grid.Column="3" Content="刷新" Click="RefreshEntityEditor_OnClick"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding EntitiesView}" SelectedItem="{Binding SelectedEntity}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DataGrid Grid.Column="2" ItemsSource="{Binding FieldsView}" SelectedItem="{Binding SelectedField}"
                              IsReadOnly="True" SelectionMode="Single"
                              MouseDoubleClick="EntityEditorFieldsGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="字段" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding ValueDisplay}" Width="*"/>
                            <DataGridTextColumn Header="允许范围" Binding="{Binding RangeDisplay}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.ColumnSpan="3" Text="{Binding EmptyText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="17" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="添加到已保存字段…" Click="SaveEntityEditorField_OnClick"
                            IsEnabled="{Binding SelectedField.CanWrite}"/>
                    <Button Content="修改选中字段…" Click="WriteEntityEditorField_OnClick"
                            IsEnabled="{Binding SelectedField.CanWrite}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="肝肾大圣-单机游戏数值编辑器" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="LOCAL GAME VALUE EDITOR" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="100" Height="32" Margin="0,0,14,0"
                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Display" SelectionChanged="Theme_OnSelectionChanged" ToolTip="切换应用主题"/>
                <Button Grid.Column="2" Content="刷新进程" Width="88" Height="32" Margin="0,0,6,0"
                        IsEnabled="{Binding CanRefreshProcesses}" Click="RefreshProcesses_OnClick"/>
                <ComboBox Grid.Column="3" Height="34" Margin="0" ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          MaxWidth="660" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="TopProcessConnectButton" Grid.Column="4" Content="连接" Width="88" Height="32" Margin="6,0,0,0"
                        IsEnabled="{Binding CanConnectProcess}" Click="AttachProcess_OnClick" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游戏库" FontSize="18" FontWeight="SemiBold" Margin="7,5"/>
                        <TextBlock Grid.Column="1" Text="本地" Foreground="{DynamicResource MutedTextBrush}" Margin="7"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="4,8,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按游戏名称或进程名搜索"/>
                        <Button Grid.Column="1" Content="清空" Margin="6,0,0,0" Padding="10,6" Click="ClearGameSearch_OnClick"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="排序：" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LibrarySortChoices}" SelectedItem="{Binding SelectedLibrarySort}"
                                  DisplayMemberPath="Display" Height="30"/>
                    </Grid>
                    <ListBox Grid.Row="3" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedLibraryGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                        <Image Source="{Binding IconSource}" Width="28" Height="28" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Badges, Mode=OneWay}"/><Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding ModuleDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ConnectionDisplay}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="3">
                            <Button Content="置顶" Click="PinGame_OnClick"/>
                            <Button Content="锁定" Click="LockGame_OnClick"/>
                            <Button Content="重命名" Click="RenameGame_OnClick"/>
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" Columns="3">
                            <Button Content="连接游戏" IsEnabled="{Binding CanConnectSelectedGame}" Click="AttachSelectedGame_OnClick"/>
                            <Button Content="断开连接" IsEnabled="{Binding CanDisconnectSelectedGame}" Click="DisconnectSelectedGame_OnClick"/>
                            <Button Content="从库移出" IsEnabled="{Binding CanRemoveCurrentGame}" Click="DeleteGame_OnClick"/>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18" Background="{DynamicResource WindowBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.RowSpan="2" Width="48" Height="48" CornerRadius="9" Background="{DynamicResource PanelRaisedBrush}" Margin="0,0,12,0">
                            <Image Source="{Binding ActiveGameIcon}" Width="38" Height="38" Stretch="Uniform"/>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActiveGameDisplayName}" FontSize="25" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding LibraryStatusText}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <Button Grid.Column="2" Content="保存入库" Width="82" Height="28"
                                        IsEnabled="{Binding CanSaveCurrentGame}"
                                        Click="AddGame_OnClick" Padding="8,2" Margin="0,0,6,0"/>
                                <Button Grid.Column="3" Content="从库移出" IsEnabled="{Binding CanRemoveCurrentGame}"
                                        Click="DeleteGame_OnClick" Width="82" Height="28" Padding="8,2" Margin="0"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="EditorGameConnectButton" Grid.Column="1" Content="连接"
                                        IsEnabled="{Binding CanConnectSelectedGame}" Click="AttachSelectedGame_OnClick"
                                        Width="64" Height="26" Padding="8,2" Margin="18,0,6,0"/>
                                <Button x:Name="EditorGameDisconnectButton" Grid.Column="2" Content="断开"
                                        IsEnabled="{Binding CanDisconnectSelectedGame}" Click="DisconnectSelectedGame_OnClick"
                                        Width="64" Height="26" Padding="8,2" Margin="0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="游戏版本" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                        <ComboBox Height="34" ItemsSource="{Binding SelectedGame.Versions}" SelectedItem="{Binding SelectedVersion}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VersionChoiceText}" ToolTip="{Binding TechnicalDetails}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,6" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding SpeedStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,18,0" MinWidth="105"/>
                        <TextBlock Text="倍数（0.01~100.00）：" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SpeedMultiplier, UpdateSourceTrigger=PropertyChanged}" Width="76" Height="29"
                                 Padding="8,2" VerticalContentAlignment="Center"
                                 ToolTip="输入 0.01 到 100.00，最多两位小数"/>
                        <Button Content="应用倍速" IsEnabled="{Binding CanAccelerate}" Click="AccelerateGame_OnClick"/>
                        <Button Content="回正" IsEnabled="{Binding CanRestoreSpeed}" Click="RestoreGameSpeed_OnClick"/>
                    </DockPanel>
                </Border>

                <TabControl x:Name="MainTabs" Grid.Row="2">
                    <TabItem Header="本游专属">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ActiveAdapterText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ModuleStatusText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,10,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="检查新有" IsEnabled="{Binding CanCheckGameModules}"
                                            Click="CheckGameModules_OnClick"/>
                                    <Button Grid.Column="2" Content="{Binding ModuleInstallActionText}" IsEnabled="{Binding CanInstallGameModule}"
                                            Click="InstallGameModule_OnClick" Margin="0,0,20,0"/>
                                    <Button Grid.Column="3" Content="卸载" IsEnabled="{Binding CanUninstallGameModule}"
                                            Click="UninstallGameModule_OnClick"/>
                                    <Button x:Name="ModuleCompatibilityDiagnosticsButton" Grid.Column="4" Content="兼容性诊断" IsEnabled="{Binding CanViewModuleCompatibilityDiagnostics}"
                                            Click="ShowModuleCompatibilityDiagnostics_OnClick" Margin="18,0,0,0"/>
                                    <Button Grid.Column="5" Content="贡献者" IsEnabled="{Binding CanViewModuleContributors}"
                                            Click="ShowModuleContributors_OnClick" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <StackPanel Visibility="{Binding HasNoActiveAdapter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                                    <TextBox Text="本地未装配该游戏专属修改模块，可使用“通用扫描”。"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                                             Background="Transparent" FontSize="20" FontWeight="SemiBold"
                                             TextAlignment="Center" TextWrapping="Wrap" Cursor="IBeam"/>
                                    <TextBox Text="请点击上方“检查新有”按钮。"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                                             Background="Transparent" FontSize="17" Foreground="{DynamicResource MutedTextBrush}"
                                             Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" Cursor="IBeam"/>
                                    <TextBox Text="如有额外需要，也可参与维护本开源项目，或者联系作者QQ群：1127372613"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                                             Background="Transparent" FontSize="17" Foreground="{DynamicResource MutedTextBrush}"
                                             Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Cursor="IBeam"/>
                                </StackPanel>
                                <TabControl x:Name="EditorModulesTabControl" TabStripPlacement="Left"
                                            ItemsSource="{Binding AdapterEditorPages}"
                                            SelectedItem="{Binding SelectedAdapterEditorPage}"
                                            Visibility="{Binding HasActiveAdapter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Descriptor.DisplayName}"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.Style>
                                    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabControl">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="136"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,10,0"
                                                                Background="{DynamicResource PanelBrush}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <TabPanel x:Name="PART_EditorModuleHeaderPanel" IsItemsHost="True"
                                                                      KeyboardNavigation.TabIndex="1"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Background="{DynamicResource WindowBrush}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Style>
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                        <Setter Property="Width" Value="134"/>
                                        <Setter Property="Padding" Value="16,12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border x:Name="EditorModuleTabChrome"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="EditorModuleTabChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="EditorModuleTabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="EditorModuleTabChrome" Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="通用扫描">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ScanValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入游戏中当前显示的数值"/>
                                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding ValueTypes}"
                                          SelectedValue="{Binding SelectedValueType}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding Comparisons}"
                                          SelectedValue="{Binding SelectedComparison}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                <ComboBox Grid.Column="3" Margin="8,0,0,0" ItemsSource="{Binding SearchRoutines}"
                                          SelectedItem="{Binding SelectedSearchRoutine}" DisplayMemberPath="DisplayName"
                                          ToolTip="搜索套路是可复用的数值编码/定位方式"/>
                                <Grid Grid.Column="4" Margin="8,0,0,0" ToolTip="按比例存储的倍数；例如界面 10、内存 20 时填 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="倍数" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ScaleMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Button Grid.Column="5" Content="首次扫描" Click="NewScan_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                                <Button Grid.Column="6" Content="再次扫描" Click="NextScan_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                                <Button Grid.Column="7" Content="撤销扫描" Click="UndoScan_OnClick" IsEnabled="{Binding CanUndoScan}"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,10,2,8">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="仅扫描可写内存" IsChecked="{Binding WritableOnly}" Margin="0,0,18,0"/>
                                    <CheckBox Content="按类型对齐" IsChecked="{Binding AlignedOnly}" Margin="0,0,18,0"/>
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="候选："/><Run Text="{Binding ScanResultCount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="取消扫描" Click="CancelScan_OnClick" IsEnabled="{Binding IsBusy}"/>
                                    <Button Content="清空结果" Click="ResetScan_OnClick" IsEnabled="{Binding IsNotBusy}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Grid.Row="2" Height="3" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PanelRaisedBrush}"/>
                             <DataGrid x:Name="ScanResultsGrid" Grid.Row="3" Margin="0,10,0,10" ItemsSource="{Binding VisibleScanResults}"
                                       SelectedItem="{Binding SelectedScanResult}" IsReadOnly="True" SelectionMode="Extended"
                                       SelectionChanged="ScanResultsGrid_OnSelectionChanged"
                                       MouseDoubleClick="ScanResultsGrid_OnMouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding AddressDisplay}" Width="1.6*"/>
                                    <DataGridTextColumn Header="界面值" Binding="{Binding CurrentDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="原始存储值" Binding="{Binding RawCurrentDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="首次" Binding="{Binding FirstDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="上一次" Binding="{Binding PreviousDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding ValueType}" Width="*"/>
                                    <DataGridTextColumn Header="搜索套路" Binding="{Binding RoutineDisplay}" Width="1.4*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                             <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="WriteScanResultsButton" Content="修改选中结果…" IsEnabled="False" Click="WriteScanResults_OnClick"/>
                                <Button x:Name="SaveScanFieldButton" Content="保存选中字段…" IsEnabled="False" Click="SaveField_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="快捷入口">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="将某个修改项保存到此处，作为已保存字段。" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="重启游戏或肝肾大圣后，可以自动定位已保存的字段，方便快捷修改。"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <Button Content="刷新数值" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshFields_OnClick"/>
                            </Grid>
                            <DataGrid x:Name="SavedFieldsGrid" Grid.Row="1" ItemsSource="{Binding SavedFields}"
                                      SelectedItem="{Binding SelectedSavedField}" IsReadOnly="True"
                                      MouseDoubleClick="SavedFieldsGrid_OnMouseDoubleClick"
                                      PreviewMouseLeftButtonDown="SavedFieldsGrid_OnPreviewMouseLeftButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="备注名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="*"/>
                                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="*"/>
                                    <DataGridTextColumn Header="锁定状态" Binding="{Binding LockDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="地址" Binding="{Binding AddressDisplay}" Width="1.5*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="删除字段" Click="DeleteField_OnClick"/>
                                <Button Content="修改字段值…" Click="WriteField_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="游戏版本">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="版本用途" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.VersionChoiceText}" VerticalAlignment="Center"/>
                            <Label Grid.Row="1" Content="游戏声明版本" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersion.GameDeclaredVersionDisplay}" VerticalAlignment="Center"/>
                            <Label Grid.Row="2" Content="游戏声明名称" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVersion.GameDeclaredProductNameDisplay}" VerticalAlignment="Center"/>
                            <Label Grid.Row="3" Content="游戏构建 GUID" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVersion.GameDeclaredBuildGuidDisplay}" VerticalAlignment="Center"/>
                            <Label Grid.Row="4" Content="平台版本" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVersion.PlatformVersionDisplay}" VerticalAlignment="Center"/>
                            <Label Grid.Row="5" Content="引擎文件版本" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVersion.FileVersion}" VerticalAlignment="Center"/>
                            <Label Grid.Row="6" Content="引擎产品版本" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedVersion.ProductVersion}" VerticalAlignment="Center"/>
                            <Label Grid.Row="7" Content="架构" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedVersion.Architecture}" VerticalAlignment="Center"/>
                            <Label Grid.Row="8" Content="收录日期" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedVersion.CollectedDateDisplay}" VerticalAlignment="Center"/>
                            <Label Grid.Row="9" Content="版本指纹（技术信息）" Padding="0" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedVersion.ExecutableSha256}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,20,0,0">
                                <TextBlock Text="本地数据位置" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LibraryPath}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,12"/>
                                <Button Content="在资源管理器中显示" HorizontalAlignment="Left" Click="OpenLibraryFolder_OnClick"/>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center">
                        <Run Text="仅用于离线单机游戏 · v"/><Run Text="{Binding CurrentApplicationVersion, Mode=OneWay}"/><Run Text="　　"/>
                    </TextBlock>
                    <Button Content="{Binding ApplicationUpdateActionText}" IsEnabled="{Binding CanUseApplicationUpdate}"
                            Click="ApplicationUpdate_OnClick" Padding="6,1" Margin="0" MinHeight="22"/>
                    <TextBlock Text="{Binding ApplicationUpdateStatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="官网" IsEnabled="{Binding CanOpenOfficialWebsite}"
                            Click="OpenOfficialWebsite_OnClick" Padding="10,1" Margin="24,0,0,0" MinHeight="22"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
