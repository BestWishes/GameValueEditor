<Window x:Class="GameValueEditor.Dialogs.GroupInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改分组" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ThemedWindowStyle}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="选择已有分组，或直接输入新的分组名称。" Foreground="{DynamicResource MutedTextBrush}"/>
        <ComboBox x:Name="GroupComboBox" Grid.Row="1" Margin="0,12,0,18"
                  IsEditable="True" IsTextSearchEnabled="False"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="80"/>
            <Button Content="保存" IsDefault="True" MinWidth="80" Click="Save_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
