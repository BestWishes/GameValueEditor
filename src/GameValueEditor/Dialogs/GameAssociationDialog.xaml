<Window x:Class="GameValueEditor.Dialogs.GameAssociationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认游戏关联" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ThemedWindowStyle}">
    <Grid Margin="24" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="筛选进程：" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
            <TextBox x:Name="SearchTextBox" TextChanged="Search_OnChanged" ToolTip="输入游戏名称或进程名筛选"/>
        </DockPanel>
        <ComboBox x:Name="ProcessComboBox" Grid.Row="2" DisplayMemberPath="DisplayName" SelectionChanged="Process_OnChanged" Margin="0,0,0,14"/>
        <TextBox x:Name="DetailsText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" Height="148"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>
        <CheckBox x:Name="ConfirmationCheckBox" Grid.Row="4" Checked="Confirmation_OnChanged" Unchecked="Confirmation_OnChanged" Margin="0,0,0,18">
            <TextBlock Text="我确认所选进程就是这个游戏，并关联到原条目。" TextWrapping="Wrap"/>
        </CheckBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="88"/>
            <Button x:Name="ConfirmButton" Content="关联并连接" MinWidth="112" IsEnabled="False" Click="Confirm_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
