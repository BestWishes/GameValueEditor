<Window x:Class="GameValueEditor.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ThemedWindowStyle}">
    <Grid Margin="24" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,22"
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel x:Name="ActionButtonsPanel" DockPanel.Dock="Left" Orientation="Horizontal"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="80"/>
                <Button Content="确定" IsDefault="True"
                        MinWidth="80" Click="Confirm_OnClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
