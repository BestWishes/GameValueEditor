<Window x:Class="GameValueEditor.Dialogs.SaveFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存字段" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="为这个字段命名"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,18" Foreground="{StaticResource MutedTextBrush}"
                   Text="名称完全由玩家填写；程序不会猜测这个地址在游戏里的含义。" TextWrapping="Wrap"/>
        <Label Grid.Row="2" Content="显示名称 *" Padding="0,0,0,5"/>
        <TextBox x:Name="NameTextBox" Grid.Row="3" Margin="0,0,0,12"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="分组" Padding="0,0,0,5"/>
                <TextBox x:Name="GroupTextBox" Text="未分组"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="备注（可选）" Padding="0,0,0,5"/>
                <TextBox x:Name="NoteTextBox"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="80"/>
            <Button Content="保存字段" Style="{StaticResource PrimaryButton}" MinWidth="100" Click="Save_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
