<Window x:Class="GameValueEditor.Dialogs.AdapterFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加专属字段" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="添加游戏专属字段"/>
        <TextBlock Grid.Row="1" Margin="0,7,0,18" Foreground="{DynamicResource MutedTextBrush}"
                   Text="适配器用游戏内的稳定字段键重新定位对象；列表里的备注名称仍由你自己填写。" TextWrapping="Wrap"/>
        <Label Grid.Row="2" Content="游戏内字段键 *" Padding="0,0,0,5"/>
        <TextBox x:Name="FieldKeyTextBox" Grid.Row="3" Margin="0,0,0,12" ToolTip="fzzml 背包适配器中填写精确物品名，例如：赤阳花"/>
        <Label Grid.Row="4" Content="备注名称 *" Padding="0,0,0,5"/>
        <TextBox x:Name="DisplayNameTextBox" Grid.Row="5" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="6">
            <Label Content="分组" Padding="0,0,0,5"/>
            <ComboBox x:Name="GroupComboBox" IsEditable="True" IsTextSearchEnabled="False"/>
        </StackPanel>
        <Grid Grid.Row="7" Margin="0,20,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" MinWidth="80"/>
                <Button Content="读取并保存" MinWidth="110" Click="Save_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
