<Window x:Class="GameValueEditor.Dialogs.ModuleCompatibilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专属模块兼容性诊断" Width="940" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource ThemedWindowStyle}">
    <Grid Margin="22" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="专属模块兼容性诊断" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,12" Foreground="{DynamicResource MutedTextBrush}"
                   Text="只执行只读兼容检查。报告已隐藏本机路径、用户名、PID、内存地址和存档内容。"
                   TextWrapping="Wrap"/>
        <DataGrid x:Name="DiagnosticsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay}" Width="64"/>
                <DataGridTextColumn Header="检查项" Binding="{Binding DisplayName}" Width="170"/>
                <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="*" MinWidth="360"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制诊断报告" MinWidth="118" Click="CopyReport_OnClick"/>
                <Button Content="关闭" IsCancel="True" MinWidth="82" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
