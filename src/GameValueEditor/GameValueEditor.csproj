<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameValueEditor</AssemblyName>
    <RootNamespace>GameValueEditor</RootNamespace>
    <Product>肝肾大圣-单机游戏数值编辑器</Product>
    <Description>A local-first memory value editor for offline single-player games.</Description>
    <Version>0.3.0-preview.16</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameValueEditorIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\GameValueEditorIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameValueEditor.ModuleSdk\GameValueEditor.ModuleSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
