{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameValueEditor application release index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "assetName", "downloadUrl", "sizeBytes", "sha256", "sourceCommit", "minimumModuleHostApi", "maximumModuleHostApi", "maximumCatalogSchemaVersion"],
        "properties": {
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]$" },
          "assetName": { "type": "string", "pattern": "^GameValueEditor-v(0|[1-9][0-9]*)\\.[0-9]\\.[0-9]-win-x64\\.zip$" },
          "downloadUrl": { "type": "string", "pattern": "^https://github\\.com/BestWishes/GameValueEditor/releases/download/v[^/]+/[^/]+\\.zip$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "sourceCommit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
          "minimumModuleHostApi": { "type": "integer", "minimum": 1 },
          "maximumModuleHostApi": { "type": "integer", "minimum": 1 },
          "maximumCatalogSchemaVersion": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
